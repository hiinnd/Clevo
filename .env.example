# Copy to an untracked .env for local work, or inject values using the hosting secret store.
# Production is the safe default. Never deploy the example unchanged.
APP_ENV=development
APP_URL=http://localhost/ClevoProject
# Generate independent 32+ random bytes, base64 encode, prefix with base64: (see security docs).
APP_KEY=
JWT_SECRET=
JWT_ISSUER=clevo
JWT_AUDIENCE=clevo-mobile
JWT_ACCESS_TTL=900
REFRESH_TTL=2592000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clevo
DB_USERNAME=
DB_PASSWORD=
# Must exist outside the public document root in production; readable/writable only by CLEVO.
PRIVATE_STORAGE_PATH=
# smtp in production; null is permitted only for development/testing and discards mail.
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=CLEVO
# Comma-separated exact origins, no wildcard. Native mobile clients need no Origin header.
CORS_ALLOWED_ORIGINS=
# Exact proxy IPs allowed to supply X-Forwarded-Proto; forwarded IP identity is not trusted.
TRUSTED_PROXIES=
OPENWEATHER_API_KEY=
LAMEA_WEBHOOK_URL=
LAMEA_WEBHOOK_TOKEN=
# Civil appointment dates/hours remain local; new ScheduledAtUtc is an explicit UTC instant.
BOOKING_TIMEZONE=Asia/Amman
# Optional absolute paths to compatible native database clients (CLI backup/rehearsal only).
MYSQLDUMP_BINARY=mysqldump
MYSQL_BINARY=mysql
# Payments remain disabled until actual sandbox onboarding/profile credentials are supplied.
# This implementation refuses online processing in APP_ENV=production, even with these values.
PAYMENT_PROVIDER=disabled
PAYMENT_MODE=disabled
PAYTABS_TEST_PROFILE_CONFIRMED=0
PAYTABS_PROFILE_ID=
PAYTABS_MERCHANT_ID=
PAYTABS_SERVER_KEY=
# CLEVO_SYNTHETIC_FINANCE is deliberately absent: only the disposable test runner sets it.

# Outbound business delivery is disabled until approved staging/production setup.
NOTIFICATION_EXTERNAL_SEND=0
FCM_ENABLED=0
FCM_SERVICE_ACCOUNT_FILE=
TRACKING_RETENTION_HOURS=1

# Production preparation: environment-specific complete references live in deploy/env/.
DB_TLS_CA_FILE=
DB_CLIENT_FLAVOR=mariadb
MAINTENANCE_MODE=0
OPS_HEALTH_TOKEN=
OPS_REQUIRE_WORKERS=0
OPS_REQUIRE_BACKUP=0
BACKUP_MAX_AGE_SECONDS=90000
FCM_EXPECTED_PROJECT_ID=
STAGING_EMAIL_ALLOWLIST=
LEGAL_OPERATOR_NAME=
SUPPORT_EMAIL=
PRIVACY_CONTACT_EMAIL=
LEGAL_POLICY_VERSION=
LEGAL_POLICY_APPROVED=0
ACCOUNT_DELETION_ENABLED=0
ACCOUNT_DELETION_PROCESSING_DAYS=0
RETENTION_DESCRIPTION_AR=
RETENTION_DESCRIPTION_EN=
ERASURE_RETENTION_REVIEW_APPROVED=0
ERASURE_WORKER_FENCE=0
