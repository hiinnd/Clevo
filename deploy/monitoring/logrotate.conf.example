/var/log/clevo/*.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    create 0640 clevo adm
    sharedscripts
    postrotate
        /usr/bin/systemctl reload apache2 >/dev/null 2>&1 || true
        /usr/bin/systemctl kill --kill-who=main --signal=USR1 php8.4-fpm.service >/dev/null 2>&1 || true
    endscript
}
