GRANT SELECT, INSERT, UPDATE ON `clevo`.`wallet` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT ON `clevo`.`wallet_transactions` TO 'clevo_runtime'@'application-host';
GRANT DELETE ON `clevo`.`blacklist` TO 'clevo_runtime'@'application-host';
-- Separate mail worker; no catalog, booking or financial DELETE privileges.
GRANT SELECT, UPDATE ON `clevo`.`security_mail_queue` TO 'clevo_mail_worker'@'worker-host';
GRANT SELECT ON `clevo`.`security_schema_migrations` TO 'clevo_mail_worker'@'worker-host';
GRANT SELECT ON `clevo`.`request_idempotency` TO 'clevo_mail_worker'@'worker-host';
GRANT DELETE ON `clevo`.`security_rate_limits` TO 'clevo_mail_worker'@'worker-host';
GRANT DELETE ON `clevo`.`auth_challenges` TO 'clevo_mail_worker'@'worker-host';
GRANT DELETE ON `clevo`.`auth_sessions` TO 'clevo_mail_worker'@'worker-host';
-- Separate notification worker: no booking, status-history or financial writes.
GRANT SELECT ON `clevo`.`security_schema_migrations` TO 'clevo_notification_worker'@'worker-host';
GRANT SELECT ON `clevo`.`request_idempotency` TO 'clevo_notification_worker'@'worker-host';
GRANT SELECT, UPDATE ON `clevo`.`notification_outbox` TO 'clevo_notification_worker'@'worker-host';
GRANT INSERT ON `clevo`.`notifications` TO 'clevo_notification_worker'@'worker-host';

GRANT SELECT, INSERT ON `clevo`.`delivery_events` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`delivery_confirmations` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`notification_preferences` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`mobile_devices` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`notification_deliveries` TO 'clevo_runtime'@'application-host';

-- Outbox worker now schedules per-user jobs atomically with inbox insert.
GRANT SELECT ON `clevo`.`notifications` TO 'clevo_notification_worker'@'worker-host';
GRANT SELECT ON `clevo`.`mobile_devices` TO 'clevo_notification_worker'@'worker-host';
GRANT INSERT ON `clevo`.`notification_deliveries` TO 'clevo_notification_worker'@'worker-host';
-- Dedicated outbound delivery worker. No booking/financial mutation or DDL.
GRANT SELECT ON `clevo`.`security_schema_migrations` TO 'clevo_delivery_worker'@'worker-host';
GRANT SELECT ON `clevo`.`request_idempotency` TO 'clevo_delivery_worker'@'worker-host';
GRANT SELECT ON `clevo`.`user` TO 'clevo_delivery_worker'@'worker-host';
GRANT SELECT ON `clevo`.`auth_sessions` TO 'clevo_delivery_worker'@'worker-host';
GRANT SELECT ON `clevo`.`notification_preferences` TO 'clevo_delivery_worker'@'worker-host';
GRANT SELECT, UPDATE ON `clevo`.`mobile_devices` TO 'clevo_delivery_worker'@'worker-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`notification_deliveries` TO 'clevo_delivery_worker'@'worker-host';
GRANT SELECT, INSERT ON `clevo`.`notifications` TO 'clevo_delivery_worker'@'worker-host';
GRANT SELECT, UPDATE ON `clevo`.`notification_outbox` TO 'clevo_delivery_worker'@'worker-host';
GRANT SELECT ON `clevo`.`booking` TO 'clevo_delivery_worker'@'worker-host';
GRANT SELECT ON `clevo`.`stations` TO 'clevo_delivery_worker'@'worker-host';
GRANT SELECT ON `clevo`.`booking_services` TO 'clevo_delivery_worker'@'worker-host';
-- GPS retention only; explicit user-requested location minimization.
GRANT SELECT ON `clevo`.`security_schema_migrations` TO 'clevo_tracking_worker'@'worker-host';
GRANT SELECT ON `clevo`.`request_idempotency` TO 'clevo_tracking_worker'@'worker-host';
GRANT SELECT ON `clevo`.`booking` TO 'clevo_tracking_worker'@'worker-host';
GRANT SELECT ON `clevo`.`driver_assignments` TO 'clevo_tracking_worker'@'worker-host';
GRANT SELECT, DELETE ON `clevo`.`tracking_records` TO 'clevo_tracking_worker'@'worker-host';
GRANT SELECT, UPDATE ON `clevo`.`delivery_confirmations` TO 'clevo_tracking_worker'@'worker-host';

-- Reviewed erasure is separate from web runtime and finance. No DDL or ledger DELETE.
GRANT SELECT, INSERT, UPDATE ON `clevo`.`account_deletion_requests` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`account_erasure_files` TO 'clevo_runtime'@'application-host';
GRANT SELECT ON `clevo`.`security_schema_migrations` TO 'clevo_privacy_worker'@'worker-host';
GRANT SELECT, UPDATE ON `clevo`.`account_deletion_requests` TO 'clevo_privacy_worker'@'worker-host';
GRANT SELECT, UPDATE ON `clevo`.`account_erasure_files` TO 'clevo_privacy_worker'@'worker-host';
GRANT SELECT ON `clevo`.`booking` TO 'clevo_privacy_worker'@'worker-host';
GRANT SELECT ON `clevo`.`user` TO 'clevo_privacy_worker'@'worker-host';
GRANT SELECT, DELETE ON `clevo`.`tracking_records` TO 'clevo_privacy_worker'@'worker-host';

-- Consistent InnoDB backup with --no-tablespaces; matching server/client version required.
GRANT SELECT, SHOW VIEW, TRIGGER, EVENT ON `clevo`.* TO 'clevo_backup'@'backup-host';
-- MySQL 8.4 routines may additionally require global SHOW_ROUTINE. Review stored routines
-- and test a restricted backup identity on the approved server before granting it.
-- Migrator: separate temporary schema-scoped DDL/DML identity; never used by PHP web/FPM.
-- Subscription expiry worker queues durable events; outbound worker delivers after commit.
GRANT SELECT ON `clevo`.`security_schema_migrations` TO 'clevo_subscription_worker'@'worker-host';
GRANT SELECT ON `clevo`.`user` TO 'clevo_subscription_worker'@'worker-host';
GRANT SELECT ON `clevo`.`plans` TO 'clevo_subscription_worker'@'worker-host';
GRANT SELECT, UPDATE ON `clevo`.`user_plans` TO 'clevo_subscription_worker'@'worker-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`request_idempotency` TO 'clevo_subscription_worker'@'worker-host';
GRANT INSERT ON `clevo`.`notification_outbox` TO 'clevo_subscription_worker'@'worker-host';
