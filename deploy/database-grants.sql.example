GRANT SELECT, INSERT, UPDATE ON `clevo`.`payments` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`plans` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`request_idempotency` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`reviews` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`security_mail_queue` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`security_rate_limits` TO 'clevo_runtime'@'application-host';
GRANT SELECT ON `clevo`.`security_schema_migrations` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`services` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`stations` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`support_messages` TO 'clevo_runtime'@'application-host';
