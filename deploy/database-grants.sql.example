-- EXAMPLE ONLY: replace database, identity and host through deployment configuration.
-- Provision credentials using the secret manager. This file contains no passwords.
-- Apply only to a new runtime identity; broader pre-existing grants must be reviewed/revoked separately.
GRANT SELECT, INSERT ON `clevo`.`audit_logs` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`auth_challenges` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`auth_refresh_tokens` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`auth_sessions` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`blacklist` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`booking` TO 'clevo_runtime'@'application-host';
-- Commercial accounting/evidence are append-only to the application identity.
GRANT SELECT, INSERT ON `clevo`.`financial_journals` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT ON `clevo`.`financial_entries` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT ON `clevo`.`financial_receipts` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT ON `clevo`.`payment_evidence` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`payment_orders` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`provider_refunds` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`subscription_redemptions` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT ON `clevo`.`financial_settlements` TO 'clevo_runtime'@'application-host';
-- Booking history is append-only; notifications are delivered from the durable outbox after commit.
GRANT SELECT, INSERT ON `clevo`.`booking_status_history` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`notification_outbox` TO 'clevo_runtime'@'application-host';
-- Additive API persistence introduced by migration 004.
GRANT SELECT, INSERT, UPDATE ON `clevo`.`saved_addresses` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`payment_sessions` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`refund_requests` TO 'clevo_runtime'@'application-host';
