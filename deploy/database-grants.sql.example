GRANT SELECT, INSERT, UPDATE ON `clevo`.`notifications` TO 'clevo_runtime'@'application-host';
GRANT SELECT, INSERT, UPDATE ON `clevo`.`notification_reads` TO 'clevo_runtime'@'application-host';
