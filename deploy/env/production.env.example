# TEMPLATE ONLY. Provision outside every web root, e.g. /etc/clevo/production.env (0640).
# Never run this template as a shell script. No domain, operator or provider is approved.
APP_ENV=production
APP_URL=https://clevo.invalid
APP_KEY=
JWT_SECRET=
JWT_ISSUER=clevo-production
JWT_AUDIENCE=clevo-mobile-production
JWT_ACCESS_TTL=900
REFRESH_TTL=2592000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clevo_production
DB_USERNAME=clevo_runtime
DB_PASSWORD=
DB_TLS_CA_FILE=
DB_CLIENT_FLAVOR=mysql
PRIVATE_STORAGE_PATH=/srv/clevo-production/private
BOOKING_TIMEZONE=Asia/Amman
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=CLEVO
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXIES=
NOTIFICATION_EXTERNAL_SEND=0
FCM_ENABLED=0
FCM_SERVICE_ACCOUNT_FILE=
FCM_EXPECTED_PROJECT_ID=
PAYMENT_PROVIDER=disabled
PAYMENT_MODE=disabled
TRACKING_RETENTION_HOURS=1
MAINTENANCE_MODE=0
# 64 lowercase random hex characters; independent from APP_KEY/JWT_SECRET.
OPS_HEALTH_TOKEN=
OPS_REQUIRE_WORKERS=1
OPS_REQUIRE_BACKUP=1
BACKUP_MAX_AGE_SECONDS=90000
# Legal operator/contact/timeline/retention must be approved before changing flags.
LEGAL_OPERATOR_NAME=
SUPPORT_EMAIL=
PRIVACY_CONTACT_EMAIL=
LEGAL_POLICY_VERSION=
LEGAL_POLICY_APPROVED=0
ACCOUNT_DELETION_ENABLED=0
ACCOUNT_DELETION_PROCESSING_DAYS=0
RETENTION_DESCRIPTION_AR=
RETENTION_DESCRIPTION_EN=
ERASURE_RETENTION_REVIEW_APPROVED=0
ERASURE_WORKER_FENCE=0
RUNTIME_PATCH_REVIEW_APPROVED=0
OUTBOUND_DELIVERY_REVIEW_APPROVED=0
RESTORE_REHEARSAL_APPROVED=0
