# systemd EnvironmentFile syntax; file 0600, root/backup service access only.
# Use a separate restricted object-store identity and independent encrypted repo password.
RESTIC_REPOSITORY=s3:https://backup.invalid/approved-bucket/clevo-production
RESTIC_PASSWORD_FILE=/etc/clevo/secrets/restic-password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
