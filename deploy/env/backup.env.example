# Dedicated SELECT-only DB identity; NO JWT, SMTP or APP_KEY needed for logical dumps.
APP_ENV=production
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clevo_production
DB_USERNAME=clevo_backup
DB_PASSWORD=
DB_TLS_CA_FILE=
DB_CLIENT_FLAVOR=mysql
PRIVATE_STORAGE_PATH=/srv/clevo-production/private
MYSQLDUMP_BINARY=/usr/bin/mysqldump
MYSQL_BINARY=/usr/bin/mysql
