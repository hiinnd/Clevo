# Separate database, credentials, Firebase project, storage and SMTP sandbox.
APP_ENV=staging
APP_URL=https://staging.clevo.invalid
APP_KEY=
JWT_SECRET=
JWT_ISSUER=clevo-staging
JWT_AUDIENCE=clevo-mobile-staging
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clevo_staging
DB_USERNAME=clevo_staging_runtime
DB_PASSWORD=
DB_TLS_CA_FILE=
PRIVATE_STORAGE_PATH=/srv/clevo-staging/private
BOOKING_TIMEZONE=Asia/Amman
MAIL_TRANSPORT=null
NOTIFICATION_EXTERNAL_SEND=0
STAGING_EMAIL_ALLOWLIST=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=CLEVO
FCM_ENABLED=0
FCM_SERVICE_ACCOUNT_FILE=
FCM_EXPECTED_PROJECT_ID=
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXIES=
PAYMENT_PROVIDER=disabled
PAYMENT_MODE=disabled
OPS_HEALTH_TOKEN=
OPS_REQUIRE_WORKERS=1
OPS_REQUIRE_BACKUP=1
BACKUP_MAX_AGE_SECONDS=90000
MAINTENANCE_MODE=0
TRACKING_RETENTION_HOURS=1
ACCOUNT_DELETION_ENABLED=0
LEGAL_POLICY_APPROVED=0
ERASURE_RETENTION_REVIEW_APPROVED=0
ERASURE_WORKER_FENCE=0
